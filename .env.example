# Copy to .env for local `vercel dev`. On Vercel, add these in Project → Settings → Environment Variables.

# Twitch app (dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Random string used to sign login cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Twitch usernames (lowercase) who are always admins, comma separated
ADMIN_LOGINS=aleksk9_

# Twitch channel to show live status for on the homepage
TWITCH_CHANNEL=aleksk9_

# Upstash Redis (added automatically when you add Upstash from Vercel → Storage).
# Either pair works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# R6 Arenyze API key for player stats lookups in the admin page (free tier: https://r6.arenyze.com)
ARENYZE_API_KEY=

# Tournament assistant on the admin page (OpenRouter, free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: model ids to try in order, comma separated. Default is the free GLM 5.2.
# OPENROUTER_MODELS=z-ai/glm-5.2:free
# Optional: set to 1 to also try other free models with tool support when the ones above fail
# OPENROUTER_FALLBACK=
# Optional: admin messages per month, shared by all admins (default 200)
# AI_MONTHLY_CAP=200
