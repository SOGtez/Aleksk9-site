# Copy to .env for local `vercel dev`. On Vercel, add these in Project → Settings → Environment Variables.

# Twitch app (dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Random string used to sign login cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Twitch usernames (lowercase) who are always admins, comma separated
ADMIN_LOGINS=aleksk9_

# Twitch channel to show live status for on the homepage
TWITCH_CHANNEL=aleksk9_

# Upstash Redis (added automatically when you add Upstash from Vercel → Storage).
# Either pair works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
